# BANXUM staging/production environment file for infra/deploy/docker-compose.yml.
# IP of Webby-Soft SRL.
#
# Copy to infra/deploy/.env (never commit it) and fill in every value marked
# REQUIRED. The backend container runs "manage.py check --deploy --fail-level ERROR"
# before it starts and stops if a required value is missing or unsafe.
# Generate secrets on the server, once per environment:
#   DJANGO_SECRET_KEY:                    python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#   AUTH_DELIVERY_SECRET_ENCRYPTION_KEY:  python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
#   AUTH_SECRET_DIGEST_PEPPER:            python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing the encryption key or pepper only invalidates login links and codes that
# are still open (15 / 10 minutes); nothing else depends on them.

# --- Environment and secrets (REQUIRED) -------------------------------------------
ENVIRONMENT=staging
DJANGO_SECRET_KEY=
AUTH_DELIVERY_SECRET_ENCRYPTION_KEY=
AUTH_SECRET_DIGEST_PEPPER=
DJANGO_ALLOWED_HOSTS=staging.banxum.example.com
PUBLIC_APP_BASE_URL=https://staging.banxum.example.com

# --- Security defaults outside local (leave unset; shown for reference) -------------
# DJANGO_DEBUG=false                  must stay false (deploy check platform_core.E003)
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# DJANGO_USE_X_FORWARDED_PROTO=true   set by docker-compose.yml
# TRUSTED_PROXY_COUNT=2               set by docker-compose.yml (Caddy -> nginx -> backend)
# DJANGO_ADMIN_ENABLED                has no effect outside local
API_DOCS_ENABLED=false

# --- Compose / database ------------------------------------------------------------
POSTGRES_DB=banxum
POSTGRES_USER=banxum
POSTGRES_PASSWORD=
PUBLIC_HTTP_PORT=8081
PUBLIC_BIND_ADDRESS=127.0.0.1

# --- Operations ---------------------------------------------------------------------
SCHEDULED_JOBS_ACTOR_EMAIL=
GARANTA_SUPERADMIN_ENABLED=true
GARANTA_SUPERADMIN_EMAIL=
GARANTA_SUPERADMIN_PASSWORD_HASH=
GARANTA_SUPERADMIN_FULL_NAME=
QA_DEV_MODE_ALLOWED=false

# --- Providers (REQUIRED in production by the deploy checks) -----------------------
# Staging may set PHONE_VERIFICATION_PROVIDER, COMMUNICATIONS_EMAIL_PROVIDER,
# FX_RATE_PROVIDER and DIDIT_SESSION_PROVIDER to mock: staging sends no real email or
# SMS (plan 19), and QA mode needs the mock email provider. A real provider, when set,
# must have its credentials.
PHONE_VERIFICATION_PROVIDER=twilio_verify
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
COMMUNICATIONS_EMAIL_PROVIDER=twilio_email
TWILIO_EMAIL_API_KEY_SID=
TWILIO_EMAIL_API_KEY_SECRET=
TWILIO_EMAIL_FROM_EMAIL=
DIDIT_SESSION_PROVIDER=api
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_WEBHOOK_REQUIRE_SIGNATURE=true
DIDIT_CALLBACK_URL=https://staging.banxum.example.com/kyc/callback
FX_RATE_PROVIDER=yahoo_finance
