{
  "name": "banxum-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dummy": "VITE_PREVIEW=true vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -b --pretty false",
    "api:generate": "orval --config orval.config.ts && node scripts/strip-generated-trailing-whitespace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-query": "^5.80.7",
    "@tanstack/react-table": "^8.21.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^26.1.0",
    "msw": "^2.8.7",
    "orval": "^7.21.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@stoplight/spectral-functions": "^1.10.2",
    "brace-expansion": "5.0.9",
    "lodash": "^4.18.1",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0"
  }
}
